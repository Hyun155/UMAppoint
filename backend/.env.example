# ── UMAppoint FastAPI Backend – Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.

# PostgreSQL / Supabase direct connection (port 5432)
DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.ulntpiicajauaxlmmize.supabase.co:5432/postgres

# JWT signing secret (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-string

# Token lifetime in minutes (default 1440 = 24 hours)
JWT_EXPIRY_MINUTES=1440

# Optional Telegram alerts to a private staff group (leave blank to disable)
# Create a bot with @BotFather, add it to your private group, then set the group chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
